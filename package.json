{
  "name": "hugeicons-cli",
  "version": "0.1.0",
  "description": "Interactive CLI for managing HugeIcons Pro icon exports. Tree-shakeable barrel files made easy.",
  "type": "module",
  "bin": {
    "hugeicons": "./bin/hugeicons.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "keywords": [
    "hugeicons",
    "hugeicons-pro",
    "icons",
    "icon-manager",
    "cli",
    "react-native",
    "react",
    "nextjs",
    "tree-shaking",
    "barrel-file"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/node": "^25.5.0",
    "lefthook": "^2.1.4",
    "typescript": "^5.9.3"
  }
}
